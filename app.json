{
  "expo": {
    "name": "HueVista",
    "slug": "huevista-mobile",
    "version": "0.1.0",
    "scheme": "huevista",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a090f",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a090f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gridstore.huevista"
    },
    "android": {
      "package": "com.gridstore.huevista",
      "adaptiveIcon": {
        "backgroundColor": "#0a090f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "HueVista needs access to your photos so you can visualize shades on a room you've already photographed.",
          "cameraPermission": "HueVista needs camera access so you can photograph a room to visualize paint shades on its walls."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "HueVista needs permission to save your visualized room to your Photos.",
          "photosPermission": "HueVista needs access to your photos to save your visualized room."
        }
      ]
    ]
  }
}
