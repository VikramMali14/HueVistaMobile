# HueVista Mobile — environment
# Copy to `.env` and adjust. EXPO_PUBLIC_* vars are inlined into the app bundle.

# Base origin of the HueVista backend (no trailing slash, no /api suffix).
# Simulator / emulator can use localhost. A PHYSICAL device cannot reach your
# laptop's localhost — use the machine's LAN IP, e.g. http://192.168.1.20:8080
EXPO_PUBLIC_API_ORIGIN=http://localhost:8080
