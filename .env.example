# HueVista Mobile — environment
# Copy to `.env` and adjust. EXPO_PUBLIC_* vars are inlined into the app bundle.

# Base origin of the HueVista backend (no trailing slash, no /api suffix).
# The client appends `/api` itself — see src/api/config.ts.
#
# Deployed backend (works on any device, no LAN or cleartext caveats):
#   EXPO_PUBLIC_API_ORIGIN=https://api.huevista.org
#
# Local backend: simulator / emulator can use localhost. A PHYSICAL device
# cannot reach your laptop's localhost — use the machine's LAN IP, e.g.
# http://192.168.1.20:8080
EXPO_PUBLIC_API_ORIGIN=http://localhost:8080

# NOTE: EXPO_PUBLIC_* vars are inlined into the JS bundle at BUILD time. Editing
# this file and reloading Metro does nothing — restart with `npx expo start --clear`.
