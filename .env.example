# HueVista Mobile — environment
# Copy to `.env` and adjust. EXPO_PUBLIC_* vars are inlined into the app bundle.

# Base origin of the HueVista backend (no trailing slash, no /api suffix).
# Simulator / emulator can use localhost. A PHYSICAL device cannot reach your
# laptop's localhost — use the machine's LAN IP, e.g. http://192.168.1.20:8080
EXPO_PUBLIC_API_ORIGIN=http://localhost:8080

# Origin of the HueVista website (no trailing slash). REQUIRED to take payment.
# Razorpay Checkout is a web library, so the sheet runs on a page the website
# serves at /pay/mobile: the app creates the order, that page opens the sheet,
# and the result comes back to EXPO_PUBLIC_PAY_REDIRECT_URI below, where the app
# verifies it. Leave this blank and the app still names every price — it just
# says buying happens at the counter instead of offering a Pay button.
# EXPO_PUBLIC_WEB_ORIGIN=https://your-huevista-site

# Where a Razorpay Checkout comes back to. Optional — the default matches the
# `scheme` in app.json and the website's own NEXT_PUBLIC_MOBILE_PAY_REDIRECT
# default, and the two MUST agree or the browser sheet never closes. Set it only
# for a build running under a different scheme.
# EXPO_PUBLIC_PAY_REDIRECT_URI=huevista://pay/callback

# Where a Google sign-in comes back to. Optional — the default matches the
# `scheme` in app.json and the backend's own `app.mobile.oauth-redirect-uri`
# default, and the two MUST agree or the browser sheet never closes. Set it only
# for a build running under a different scheme.
# EXPO_PUBLIC_OAUTH_REDIRECT_URI=huevista://sign-in/callback
