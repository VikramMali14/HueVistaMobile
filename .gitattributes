# Normalize all text files to LF in the repository.
# Git stores LF; checkouts get LF on every platform, so Windows editors
# no longer show every file as modified after a line-ending flip.
* text=auto eol=lf

# Windows-only scripts must keep CRLF to run correctly.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Gradle wrapper: shell script needs LF, Windows wrapper needs CRLF.
gradlew text eol=lf
gradlew.bat text eol=crlf

# Binary files — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.jar binary
*.keystore binary
*.apk binary
*.aab binary
*.mp4 binary
*.mov binary
